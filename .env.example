# Copy to .env.local and fill in what you have. Every value is optional in
# development: without a key, that source falls back to built-in mock data.
# These are read on the server only. Never prefix them with NEXT_PUBLIC_.

# https://newsapi.org/register  (free developer plan works from localhost)
NEWS_API_KEY=

# https://www.themoviedb.org/settings/api. Set ONE of these:
#   the v4 "API Read Access Token" (preferred, sent as a header) ...
TMDB_API_READ_TOKEN=
#   ... or the v3 "API Key" (sent as a query parameter, server-side only)
TMDB_API_KEY=

# Supabase (optional): persistent accounts + per-user favorites. Run
# supabase/migrations/0001_users_and_favorites.sql once in the SQL editor first.
# Without these, accounts/favorites are kept in server memory (resets on restart).
SUPABASE_URL=
# Server-only secret key (sb_secret_...). Bypasses RLS: never expose to the browser.
SUPABASE_SECRET_KEY=
# Publishable key (sb_publishable_...). Not used by the app today (the browser
# never calls Supabase directly); kept for future client features.
SUPABASE_PUBLISHABLE_KEY=

# Signs the session cookie. REQUIRED in production; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Interval in ms between mock live posts on the real-time stream (default 20000).
LIVE_FEED_INTERVAL_MS=
